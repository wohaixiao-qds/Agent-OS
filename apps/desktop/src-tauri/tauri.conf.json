{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "ZYAOS",
  "version": "0.1.4",
  "identifier": "com.wohaixiao.agent-os",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "node ../../scripts/prepare-bundle.mjs && pnpm build"
  },
  "app": {
    "windows": [
      {
        "title": "ZY AOS",
        "width": 1440,
        "height": 900,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [
      "resources/runtime/**/*",
      "resources/node/**/*",
      "resources/skills/**/*"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["SimpChinese", "English"]
      }
    },
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}
